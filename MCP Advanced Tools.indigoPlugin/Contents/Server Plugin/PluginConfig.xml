<?xml version="1.0"?>
<PluginConfig>
    <!-- OpenAI Configuration -->
    <Field id="openai_api_key" type="textfield" defaultValue="" secure="true"
           tooltip="Required for semantic search capabilities">
        <Label>OpenAI API Key:</Label>
    </Field>

    <Field id="api_key_help" type="label" fontSize="small" alignWithControl="false" alignText="left">
        <Label>Enter your OpenAI API key to enable semantic search. Get your API key from
            https://platform.openai.com/api-keys
        </Label>
    </Field>

    <Field id="separator1" type="separator"/>

    <!-- Model Configuration -->
    <Field id="small_model" type="menu" defaultValue="gpt-6-luna">
        <Label>Model:</Label>
        <List>
            <Option value="gpt-6-luna">gpt-6-luna (recommended)</Option>
            <Option value="gpt-5.4-mini">gpt-5.4-mini</Option>
        </List>
    </Field>

    <Field id="small_model_help" type="label" fontSize="small" alignWithControl="true">
        <Label>Used for search keywords, search query expansion and picking history properties.</Label>
    </Field>

    <Field id="separator2" type="separator"/>

    <!-- LangSmith Configuration -->
    <Field type="checkbox" id="enable_langsmith" defaultValue="false">
        <Label>Enable LangSmith Tracing:</Label>
    </Field>
    <Field enabledBindingId="enable_langsmith" enabledBindingNegate="false" type="textfield" id="langsmith_endpoint"
           defaultValue="https://api.smith.langchain.com">
        <Label>LangSmith Endpoint URL:</Label>
    </Field>
    <Field enabledBindingId="enable_langsmith" enabledBindingNegate="false" type="textfield" id="langsmith_api_key"
           defaultValue="">
        <Label>LangSmith API Key:</Label>
    </Field>
    <Field enabledBindingId="enable_langsmith" enabledBindingNegate="false" type="textfield" id="langsmith_project"
           defaultValue="indigo-mcp-server">
        <Label>LangSmith Project Name:</Label>
    </Field>

    <Field id="separator4" type="separator"/>

    <!-- Event Webhooks -->
    <Field type="checkbox" id="enable_webhooks" defaultValue="false">
        <Label>Enable Event Webhooks:</Label>
        <Description>Allow MCP clients to create event subscriptions with webhook callbacks.
            When disabled, subscription tools are hidden from MCP clients.</Description>
    </Field>

    <Field id="separator_webhooks" type="separator"/>

    <!-- Automation Delete Safety -->
    <Field type="checkbox" id="enable_automation_delete" defaultValue="false">
        <Label>Allow AI to delete automations:</Label>
        <Description>Allow MCP clients to delete triggers, schedules, and action groups
            (deletion is irreversible; each call also requires confirm=true). All other
            automation tools — enable/disable, execute, duplicate, rename, and editing a
            trigger's event settings — are always available and do not need this.</Description>
    </Field>

    <!-- Tags (Indigo 2026.1) -->
    <Field type="checkbox" id="enable_tag_delete" defaultValue="false">
        <Label>Allow AI to delete tags:</Label>
        <Description>Allow MCP clients to delete a tag from Indigo's tag library, which removes it
            from every object carrying it (irreversible; each call also requires confirm=true).
            Creating, renaming, recoloring and assigning tags are always available.</Description>
    </Field>
    <Field id="confirm_tag" type="textfield" defaultValue="ask-first">
        <Label>Confirmation tag:</Label>
    </Field>
    <Field id="confirm_tag_help" type="label" fontSize="small" alignWithControl="true">
        <Label>An AI must pass confirm=true to enable, disable, edit, move, duplicate or delete a
            trigger, schedule or action group carrying this tag, and to remove or rename the tag
            itself. Leave empty to turn this off.</Label>
    </Field>

    <!-- Plugin-Provided Tools -->
    <!-- Option values must not contain one another: visibleBindingValue
         matches by substring. The two lists are separate on purpose so that
         switching the mode never reinterprets a saved selection. -->
    <Field id="external_tool_policy" type="menu" defaultValue="all">
        <Label>Plugins that may provide MCP tools:</Label>
        <List>
            <Option value="all">All plugins</Option>
            <Option value="allowlist">Only the plugins selected below</Option>
            <Option value="blocklist">All plugins except those selected below</Option>
        </List>
    </Field>

    <Field id="external_tool_allowlist" type="list" rows="10"
           visibleBindingId="external_tool_policy" visibleBindingValue="allowlist"
           alwaysUseInDialogHeightCalc="true">
        <Label>Allowed plugins:</Label>
        <List class="self" method="external_tool_plugin_list"/>
    </Field>

    <Field id="external_tool_blocklist" type="list" rows="10"
           visibleBindingId="external_tool_policy" visibleBindingValue="blocklist"
           alwaysUseInDialogHeightCalc="true">
        <Label>Blocked plugins:</Label>
        <List class="self" method="external_tool_plugin_list"/>
    </Field>

    <Field id="external_tool_policy_help" type="label" fontSize="small" alignWithControl="true">
        <Label>Plugins marked "MCP tools: N" ship tools today. You can select any plugin, so a plugin that adds tools later is already covered. Takes effect immediately.</Label>
    </Field>

    <Field type="checkbox" id="enable_external_tool_writes" defaultValue="true">
        <Label>Allow plugin-provided tools to make changes:</Label>
        <Description>Other Indigo plugins can contribute MCP tools (e.g. Auto Lights
            config editing). When unchecked, their write tools are refused and only
            their read tools work. Takes effect immediately.</Description>
    </Field>

    <Field id="separator_automation" type="separator"/>

    <!-- Debug Settings -->

    <Field id="log_level" type="menu" defaultValue="20">
        <Label>Event Logging Level:</Label>
        <List>
            <Option value="5">Extra Debugging Messages</Option>
            <Option value="10">Debugging Messages</Option>
            <Option value="20">Informational Messages</Option>
            <Option value="30">Warning Messages</Option>
            <Option value="40">Error Messages</Option>
            <Option value="50">Critical Errors Only</Option>
        </List>
    </Field>

    <Field id="log_mcp_activity" type="checkbox" defaultValue="false">
        <Label>Log AI read activity:</Label>
        <Description>Also log read-only MCP requests (searches, lists, lookups) to the event log.
            Changes made through this plugin (automation control and edits, event
            subscriptions, plugin-provided write tools) are always logged.</Description>
    </Field>

    <Field id="separator5" type="separator"/>

    <!-- Connection Testing -->
    <Field id="test_connections_button" type="button">
        <Label>Test Connections</Label>
        <Title>Test All Connections</Title>
        <CallbackMethod>test_connections_button</CallbackMethod>
    </Field>

    <Field id="connection_status_help" type="label" fontSize="small" alignWithControl="false" alignText="left">
        <Label>Click to test the OpenAI connection with the current configuration</Label>
    </Field>
</PluginConfig>